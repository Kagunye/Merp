{
  "version": 2,
  "buildCommand": "./build_files.sh",
  "outputDirectory": "staticfiles_build",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb" }
    },
    {
      "src": "staticfiles_build/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/staticfiles_build/static/$1" },
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
