# Copy this file to .env and fill in your values
DEBUG=True
SECRET_KEY=change-this-to-a-random-50-char-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
# Public address of the site, used for links in emails (password reset,
# company invitations). Required in production: without it those emails are
# not sent. No trailing slash.
SITE_URL=http://localhost:8000
# Largest upload accepted, in bytes (default 10 MB).
# MAX_UPLOAD_SIZE=10485760

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgresql://user:password@localhost:5432/merp_db
# A client's own MySQL server (MySQL 8.0+ / MariaDB 10.6+); create the database with
#   CREATE DATABASE merp CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# DATABASE_URL=mysql://merp:password@192.168.1.10:3306/merp

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@merp.local

# Currency
CURRENCY_DEFAULT=KES
CURRENCY_SYMBOL=KSh

# AWS S3 (production file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
